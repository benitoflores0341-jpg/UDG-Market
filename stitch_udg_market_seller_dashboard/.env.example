# Host y puerto del servidor MySQL.
DB_HOST=localhost
DB_PORT=3306
# Nombre de la base de datos que debe coincidir con la configurada en MySQL.
DB_DATABASE=udg_market
# Credenciales de MySQL usadas por el backend.
DB_USERNAME=root
DB_PASSWORD=
# Secreto privado para firmar sesiones y tokens QR; usa al menos 32 caracteres aleatorios.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Puerto HTTP y entorno en que se ejecuta Express.
PORT=3000
NODE_ENV=development
# Tamaño máximo de imágenes aceptadas, expresado en megabytes.
IMAGE_MAX_SIZE_MB=5
